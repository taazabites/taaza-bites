rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'diet', 'goal']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 200 &&
             data.diet is string && data.diet.size() <= 50 &&
             data.goal is string && data.goal.size() <= 50 &&
             (!('dislikes' in data) || (data.dislikes is list && data.dislikes.size() <= 50)) &&
             (!('allergies' in data) || (data.allergies is list && data.allergies.size() <= 50));
    }

    function isValidVitalityLog(data) {
      return data.keys().hasAll(['waterIntake', 'steps', 'activeMinutes', 'caloriesBurned', 'date']) &&
             data.keys().size() == 5 &&
             data.waterIntake is number &&
             data.steps is number &&
             data.activeMinutes is number &&
             data.caloriesBurned is number &&
             data.date is string && data.date.size() <= 20;
    }

    function isValidMacroCalculatorResults(data) {
      return data.keys().hasAll(['bmr', 'tdee', 'targetCalories', 'protein', 'carbs', 'fats', 'goal', 'dietType']) &&
             data.keys().size() == 8 &&
             data.bmr is number &&
             data.tdee is number &&
             data.targetCalories is number &&
             data.protein is number &&
             data.carbs is number &&
             data.fats is number &&
             data.goal is string && data.goal.size() <= 50 &&
             data.dietType is string && data.dietType.size() <= 50;
    }

    function isValidFaqSearch(data) {
      return data.keys().hasAll(['query', 'timestamp', 'resultsCount']) &&
             data.keys().size() == 3 &&
             data.query is string && data.query.size() <= 100 &&
             data.timestamp == request.time &&
             data.resultsCount is int;
    }

    function isValidFaqFeedback(data) {
      return data.keys().hasAll(['questionId', 'questionText', 'helpful', 'timestamp']) &&
             data.keys().size() == 4 &&
             data.questionId is string && data.questionId.size() <= 100 &&
             data.questionText is string && data.questionText.size() <= 200 &&
             data.helpful is bool &&
             data.timestamp == request.time;
    }

    function isValidMealFeedback(data) {
      return data.keys().hasAll(['mealId', 'mealName', 'rating', 'userId', 'userDisplayName', 'timestamp']) &&
             (data.keys().size() == 6 || (data.keys().size() == 7 && 'comments' in data)) &&
             data.mealId is string && data.mealId.size() <= 100 &&
             data.mealName is string && data.mealName.size() <= 200 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.userId == request.auth.uid &&
             data.userDisplayName is string && data.userDisplayName.size() <= 200 &&
             (!('comments' in data) || (data.comments is string && data.comments.size() <= 1000)) &&
             data.timestamp == request.time;
    }

    function isValidOrderFeedback(data) {
      return data.keys().hasAll(['orderId', 'mealName', 'mealRating', 'packagingRating', 'userId', 'userDisplayName', 'timestamp']) &&
             (data.keys().size() == 7 || (data.keys().size() == 8 && 'comments' in data)) &&
             data.orderId is string && data.orderId.size() <= 100 &&
             data.mealName is string && data.mealName.size() <= 200 &&
             data.mealRating is number && data.mealRating >= 1 && data.mealRating <= 5 &&
             data.packagingRating is number && data.packagingRating >= 1 && data.packagingRating <= 5 &&
             data.userId == request.auth.uid &&
             data.userDisplayName is string && data.userDisplayName.size() <= 200 &&
             (!('comments' in data) || (data.comments is string && data.comments.size() <= 1000)) &&
             data.timestamp == request.time;
    }

    function isValidJobApplication(data) {
      return data.keys().hasAll(['fullName', 'mobile', 'email', 'position', 'location', 'experience', 'timestamp']) &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.mobile is string && data.mobile.size() <= 50 &&
             data.email is string && data.email.size() <= 200 &&
             data.position is string && data.position.size() <= 100 &&
             data.location is string && data.location.size() <= 200 &&
             data.experience is string && data.experience.size() <= 50 &&
             (!('expectedSalary' in data) || (data.expectedSalary is string && data.expectedSalary.size() <= 100)) &&
             (!('joiningDate' in data) || (data.joiningDate is string && data.joiningDate.size() <= 50)) &&
             (!('comments' in data) || (data.comments is string && data.comments.size() <= 2000)) &&
             (!('resumeName' in data) || (data.resumeName is string && data.resumeName.size() <= 250)) &&
             (!('resumeSize' in data) || (data.resumeSize is number)) &&
             data.timestamp == request.time;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && isValidUserProfile(incoming());

      match /vitality_logs/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && isValidId(date) && (request.method == 'delete' || isValidVitalityLog(incoming()));
      }

      match /macro_calculator/results {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId && (request.method == 'delete' || isValidMacroCalculatorResults(incoming()));
      }
    }

    match /faq_searches/{searchId} {
      allow create: if request.auth != null && isValidId(searchId) && isValidFaqSearch(incoming());
      allow read: if false;
    }

    match /faq_feedback/{feedbackId} {
      allow create: if request.auth != null && isValidId(feedbackId) && isValidFaqFeedback(incoming());
      allow read: if false;
    }

    match /meal_feedback/{feedbackId} {
      allow create: if request.auth != null && isValidId(feedbackId) && isValidMealFeedback(incoming());
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    match /order_feedback/{feedbackId} {
      allow create: if request.auth != null && isValidId(feedbackId) && isValidOrderFeedback(incoming());
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /job_applications/{applicationId} {
      allow create: if isValidId(applicationId) && isValidJobApplication(incoming());
      allow read: if false;
    }
  }
}
