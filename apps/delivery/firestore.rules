rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPartner() {
      return signedIn() && exists(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid));
    }

    function partnerDoc() {
      return get(/databases/$(database)/documents/deliveryPartners/$(request.auth.uid)).data;
    }

    function notSuspended() {
      return isPartner()
        && partnerDoc().get('active', true) == true
        && partnerDoc().get('isBlocked', false) != true
        && partnerDoc().get('currentStatus', 'OFFLINE') != 'SUSPENDED';
    }

    function ownDelivery() {
      return resource.data.partnerId == request.auth.uid
        || resource.data.driverId == request.auth.uid;
    }

    function legalTransition() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return from == to
        || (from == 'ASSIGNED' && to in ['ACCEPTED', 'FAILED', 'CANCELLED', 'RETURN_TO_KITCHEN'])
        || (from == 'ACCEPTED' && to in ['PICKED_UP', 'FAILED', 'CANCELLED', 'RETURN_TO_KITCHEN'])
        || (from == 'PICKED_UP' && to in ['OUT_FOR_DELIVERY', 'FAILED', 'RETURN_TO_KITCHEN'])
        || (from == 'OUT_FOR_DELIVERY' && to in ['ARRIVED', 'FAILED', 'RETURN_TO_KITCHEN'])
        || (from == 'ARRIVED' && to in ['FAILED', 'RETURN_TO_KITCHEN']);
    }

    function deliveryProtectedUnchanged() {
      return request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.get('paymentStatus', '') == resource.data.get('paymentStatus', '')
        && request.resource.data.get('customerId', '') == resource.data.get('customerId', '')
        && request.resource.data.status != 'DELIVERED';
    }

    match /deliveryPartners/{partnerId} {
      allow read: if signedIn() && request.auth.uid == partnerId;
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == partnerId
        && resource.data.get('currentStatus', '') != 'SUSPENDED'
        && request.resource.data.get('name', '') == resource.data.get('name', '')
        && request.resource.data.get('phone', '') == resource.data.get('phone', '')
        && request.resource.data.get('vehicleType', '') == resource.data.get('vehicleType', '')
        && request.resource.data.get('vehicleNumber', '') == resource.data.get('vehicleNumber', '')
        && request.resource.data.get('active', true) == resource.data.get('active', true)
        && request.resource.data.currentStatus in ['ONLINE', 'OFFLINE', 'ON_DELIVERY'];
      allow delete: if false;
    }

    match /deliveries/{deliveryId} {
      allow read: if isPartner() && ownDelivery();
      allow create: if false;
      allow update: if notSuspended() && ownDelivery() && legalTransition() && deliveryProtectedUnchanged();
      allow delete: if false;
    }

    match /deliveryEvents/{eventId} {
      allow read: if isPartner() && resource.data.partnerId == request.auth.uid;
      allow create: if notSuspended()
        && request.resource.data.partnerId == request.auth.uid
        && request.resource.data.type in ['STATUS', 'ISSUE', 'PICKUP'];
      allow update, delete: if false;
    }

    match /deliveryEarnings/{earningId} {
      allow read: if isPartner() && resource.data.partnerId == request.auth.uid;
      allow write: if false;
    }

    match /deliveryIssues/{issueId} {
      allow read: if isPartner() && resource.data.reportedBy == request.auth.uid;
      allow create: if notSuspended() && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /deliverySecrets/{id} {
      allow read, write: if false;
    }

    match /partnerNotifications/{id} {
      allow read: if isPartner() && resource.data.partnerId == request.auth.uid;
      allow update: if isPartner()
        && resource.data.partnerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /deliverySettings/{id} {
      allow read: if isPartner();
      allow write: if false;
    }

    match /deliveryTracking/{id} {
      allow read: if isPartner() && resource.data.partnerId == request.auth.uid;
      allow create: if notSuspended() && request.resource.data.partnerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
