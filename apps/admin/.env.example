# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Client-Side Firebase Config (Safe for browser)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="taazabites.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="taazabites"
VITE_FIREBASE_STORAGE_BUCKET="taazabites.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Client-Side Razorpay Key
VITE_RAZORPAY_KEY_ID="rzp_live_XXXXXX"

# Server-Side Secrets (Server Only - DO NOT prefix with VITE)
RAZORPAY_KEY_SECRET="your_live_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_from_dashboard"

# Firebase Admin SDK
# Generate this JSON from Firebase Project Settings -> Service Accounts
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@taazabites.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXX\n-----END PRIVATE KEY-----\n"

# Gupshup WhatsApp API
GUPSHUP_API_KEY="your_api_key"
GUPSHUP_APP_NAME="your_app_name"
GUPSHUP_BASE_URL="https://api.gupshup.io"
GUPSHUP_WEBHOOK_URL="https://your-app.com/api/webhooks/gupshup"

# Email (Brevo)
BREVO_SMTP_KEY="your_brevo_api_key"
SENDER_EMAIL="notifications@taazabites.in"

# Google Maps API
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_platform_key"
VITE_GOOGLE_MAPS_API_KEY="your_api_key"

