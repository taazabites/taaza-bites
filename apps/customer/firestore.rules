rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function ownedBy(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid ||
        data.customerId == request.auth.uid
      );
    }

    match /_health_check/{document=**} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer';
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('walletBalance', 0) == resource.data.get('walletBalance', 0)
        && request.resource.data.get('rewardPoints', 0) == resource.data.get('rewardPoints', 0);
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId);
      allow update: if isOwner(customerId)
        && request.resource.data.get('role', 'customer') == resource.data.get('role', 'customer')
        && request.resource.data.get('walletBalance', 0) == resource.data.get('walletBalance', 0)
        && request.resource.data.get('rewardPoints', 0) == resource.data.get('rewardPoints', 0);
      allow delete: if false;
    }

    match /customerProfiles/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /customerPreferences/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /customerAddresses/{addressId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /addresses/{addressId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /healthAssessments/{assessmentId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || assessmentId == request.auth.uid
      ));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /bodyMetrics/{metricId} {
      allow read, create, update: if isAdmin() || ownedBy(resource.data);
      allow delete: if false;
    }

    match /mealSchedules/{scheduleId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.deliveryStatus in ['pending', 'skipped', 'paused', 'preparing', 'packed', 'out_for_delivery', 'delivered', 'scheduled'];
      allow create, delete: if isAdmin();
    }

    match /healthProgress/{progressId} {
      allow read, create, update: if isAdmin() || ownedBy(resource.data);
      allow delete: if false;
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mealItems/{mealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /meals/{mealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mealPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /serviceAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid
      ));
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.planId == resource.data.planId
        && request.resource.data.get('paymentId', '') == resource.data.get('paymentId', '')
        && request.resource.data.get('razorpaySubscriptionId', '') == resource.data.get('razorpaySubscriptionId', '')
        && request.resource.data.status in ['active', 'paused', 'cancelled']
        && resource.data.status in ['active', 'paused', 'expiring', 'pending']
        && !(resource.data.status == 'pending' && request.resource.data.status == 'active');
      allow delete: if false;
    }

    match /subscriptionDrafts/{draftId} {
      allow read, create, update: if isSignedIn() && (
        draftId == request.auth.uid || request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /subscriptionEvents/{eventId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /razorpayOrders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /kitchenQueue/{itemId} {
      allow read, write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /rewardPoints/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /rewards/{rewardId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow delete: if false;
    }

    match /pushNotifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /analyticsEvents/{eventId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /emailQueue/{jobId} {
      allow read, write: if isAdmin();
    }

    match /smsQueue/{jobId} {
      allow read, write: if isAdmin();
    }

    match /calendarMonths/{monthId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyMeals/{mealId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mealReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /customerReviews/{reviewId} {
      allow read: if resource.data.get('approved', false) == true || isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.get('approved', false) == false;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /emailLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /whatsappLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /auditLogs/{docId} {
      allow read, write: if isAdmin();
    }

    match /marketingCampaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isSignedIn() && (resource.data.referrerUserId == request.auth.uid || resource.data.referredUserId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /referralRewards/{rewardId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /referralCodes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyCheckins/{checkinId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /dailyCheckIns/{checkinId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /deliveryRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mealAnalytics/{analyticsId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    match /mealCustomizations/{customId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /nutritionReports/{reportId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /pauseRequests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /subscriptionChanges/{changeId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /weightLogs/{logId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /rewardTransactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /walletTransactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /aiCache/{cacheId} {
      allow read, write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
