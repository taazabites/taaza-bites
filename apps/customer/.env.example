# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Config
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Razorpay Config
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
VITE_RAZORPAY_KEY_ID=""
VITE_RAZORPAY_PAYMENT_LINK="https://rzp.io/l/taazabites"
GOOGLE_MAPS_PLATFORM_KEY=""

# Brevo Email SMTP Integration (Module 4)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@taazabites.com"
BREVO_SENDER_NAME="Taaza Bites"

# Gupshup WhatsApp API Integration
GUPSHUP_API_KEY=""
GUPSHUP_APP_NAME=""
GUPSHUP_SOURCE_NUMBER=""

# ---------------------------------------------------------------------------
# Airtel IQ + DLT SMS (server-only — do NOT prefix with VITE_)
# DLT registration alone is not enough; you also need Airtel IQ (or another
# SMS gateway) API credentials that will send using these DLT IDs.
# ---------------------------------------------------------------------------
AIRTEL_IQ_BASE_URL="https://iqsms.airtel.in"
AIRTEL_IQ_USERNAME=""
AIRTEL_IQ_PASSWORD=""
AIRTEL_IQ_CUSTOMER_ID=""
AIRTEL_DLT_ENTITY_ID=""
AIRTEL_DLT_HEADER_ID="TAAZAB"
# Set true to use /api/otp/dlt/* even before IQ credentials are filled (dev/sim)
AIRTEL_DLT_LOGIN_ENABLED="false"

# Approved DLT template IDs (numeric strings from Airtel DLT portal)
AIRTEL_DLT_OTP_TEMPLATE_ID=""
